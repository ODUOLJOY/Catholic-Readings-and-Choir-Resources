# Required application settings
DATABASE_URL=sqlite:///./catholic_readings.db
SECRET_KEY=replace-with-a-long-random-secret-before-running
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTO_CREATE_TABLES=false
DEBUG=false

# API and web origins
API_V1_PREFIX=/api
FRONTEND_URL=http://localhost:8081
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:8081","http://localhost:19006","http://127.0.0.1:8081","http://127.0.0.1:19006"]

# Initial administrator: configure only for the intended verified account
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# Scheduled publishing; keep unset unless a protected scheduler is configured
SCHEDULED_JOB_TOKEN=

# Local private storage for development. Use Firebase plus ADC/workload
# identity or secret-managed service-account credentials for hosted storage.
STORAGE_BACKEND=local
STORAGE_PATH=storage
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MAX_IMAGE_SIZE=5242880
MAX_AUDIO_SIZE=52428800
MAX_VIDEO_SIZE=314572800
MAX_DOCUMENT_SIZE=20971520
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_DOCUMENT_TYPES=pdf
ALLOWED_AUDIO_TYPES=mp3,wav,m4a,aac
ALLOWED_VIDEO_TYPES=mp4,mov,mkv

# SMTP (password reset and transactional messages)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# M-Pesa Daraja. Keep in sandbox until external production activation.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
MPESA_ACCOUNT_REFERENCE=CatholicReadings
MPESA_TRANSACTION_DESCRIPTION=Catholic Readings Subscription
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_MONTHLY_AMOUNT=10
MPESA_RECIPIENT_NUMBER=
